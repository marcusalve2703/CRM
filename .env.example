# Database connection
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"

# App config
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-key-change-in-production"

# Redis Config (para filas e tarefas em background)
REDIS_URL="redis://localhost:6379"

# Prospecção de Empresas (Fontes 100% Gratuitas ativadas por padrão)
ENABLE_BRASIL_API="true"
ENABLE_OVERPASS_OSM="true"

# APIs opcionais (usuário pode adicionar no painel para recursos avançados)
GROQ_API_KEY=""
OPENAI_API_KEY=""
